# คัดลอกเป็น .env ด้วย `make init` (จะสุ่ม JWT_SECRET ให้อัตโนมัติ)
# ห้าม commit ไฟล์ .env — chmod 600

# ---------- deployment ----------
# service เสริมที่ docker compose จะเปิดด้วย (คั่นด้วย comma)
#   matter = รัน matter-server ในเครื่องนี้ (Pi 4/5 แบบ all-in-one เท่านั้น)
#   tunnel = Cloudflare Tunnel
# cloud VM เว้นว่าง — matter-server อยู่บน Pi แล้วต่อผ่าน Tailscale
COMPOSE_PROFILES=

# ---------- device layer ----------
# matter = local ผ่าน python-matter-server (หลัก)
# tuya   = Tuya Cloud อย่างเดียว
# hybrid = Matter หลัก + Tuya fallback (DeviceRouter)
# mock   = จำลอง ไม่ต้องมีฮาร์ดแวร์
IOT_ADAPTER=mock

# python-matter-server — ต้องรันบน Linux host วง L2 เดียวกับ M1
#   รัน uvicorn ตรง ๆ บนเครื่องเดียวกัน : ws://127.0.0.1:5580/ws
#   app อยู่ใน container (docker compose): ws://host.docker.internal:5580/ws
#   matter-server อยู่คนละเครื่อง        : ws://<ip>:5580/ws
MATTER_WS_URL=ws://127.0.0.1:5580/ws

# วินาทีที่รอ state echo กลับจากอุปกรณ์ก่อนถือว่าคำสั่งล้มเหลว
COMMAND_TIMEOUT=5.0

# ---------- tuya cloud (เฉพาะเมื่อใช้ tuya/hybrid) ----------
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_REGION=us
TUYA_UID=
# ห้ามต่ำกว่า 10 วินาที — Tuya rate limit
TUYA_POLL_SECONDS=15

# ---------- storage ----------
# เว้นว่าง = ปิด history ทั้งหมด (monitor/control ยังทำงานปกติ)
# ค่านี้คือ DSN ฝั่ง host (make migrate, backup.sh, uvicorn ตรง ๆ)
# ส่วน container จะถูก compose เปลี่ยนเป็น @db:5432 ให้เอง
DATABASE_URL=postgresql://iot:CHANGE_ME_TOO@127.0.0.1:5432/iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=CHANGE_ME_TOO
POSTGRES_DB=iot
# ปกติ container `migrate` เป็นคนรัน; เปิดอันนี้เมื่อรัน uvicorn ตรง ๆ ตอน dev
RUN_MIGRATIONS=0

# ---------- http ----------
HOST=0.0.0.0
PORT=8000
# interface ที่เปิดพอร์ต dashboard บน host
#   0.0.0.0   = เข้าจาก LAN ได้ (Pi all-in-one)
#   127.0.0.1 = เข้าได้เฉพาะผ่าน tailscale serve / cloudflared (cloud VM)
APP_BIND=0.0.0.0
# IP ของ reverse proxy ที่ยอมเชื่อ X-Forwarded-For (ค่าเริ่มต้น = ไม่เชื่อใครเลย)
FORWARDED_ALLOW_IPS=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=*
# Cloudflare ตัด WebSocket ที่ idle เกิน ~100 วินาที
WS_PING_SECONDS=25

# เปิด POST /api/devices/commission (ปกติใช้ scripts/commission.py ผ่าน shell แทน)
ALLOW_HTTP_COMMISSION=0

# ---------- security (เฟสถัดไป) ----------
JWT_SECRET=CHANGE_ME_RUN_MAKE_INIT

# ---------- remote access ----------
CF_TUNNEL_TOKEN=
